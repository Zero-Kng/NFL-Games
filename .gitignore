# Cache do dataset antigo (Big Data Bowl 2023). Nao e mais lido nem gerado;
# fica ignorado ate a pasta ser apagada das maquinas.
cache/

# Dataset antigo (Big Data Bowl 2023, 826 MB). O app nao o le mais e ele saiu do
# versionamento; fica ignorado ate a pasta ser apagada das maquinas.
nfl-big-data-bowl-regional-event-data-main/

# Dados baixados do nflverse e tabelas montadas (etl/fontes.py, etl/montar.py).
# ~330 MB baixados na 1a subida; os brutos das temporadas encerradas sao
# descartados depois de montados. Recriado a partir das fontes se for apagado.
dados/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Temporarios de escrita atomica (so existem se um processo for interrompido)
*.tmp

# Executavel gerado pelo tools/empacotar.py (PyInstaller); publicado nas Releases, nao no Git.
# Na raiz, ele usa a mesma pasta dados/ do projeto.
dist/
build/
/NFL-Games.exe
/nfl-games

# Site estatico gerado pelo tools/exportar.py (GitHub Pages; publicado pelo Actions, nao pelo Git)
site/

# Atalho do Windows criado por tools/atalho.py (guarda caminhos desta maquina)
/NFL Games.lnk
